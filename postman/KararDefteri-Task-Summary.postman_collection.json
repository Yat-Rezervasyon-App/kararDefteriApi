                                                      "url":  "{{baseUrl}}/api/projects/{{projectId}}/summary"
                                                  }
                                  },
                                  {
                                      "name":  "Get My Summary",
                                      "request":  {
                                                      "method":  "GET",
                                                      "header":  [

                                                                 ],
                                                      "url":  "{{baseUrl}}/api/users/me/summary"
                                                  }
                                  }
                              ]
                 }
             ]
}
